{
  "name": "cascade",
  "private": true,
  "version": "1.2.363",
  "type": "module",
  "description": "Cascade - a browser-based osu!mania beatmap editor",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-landing-pages.mjs && node scripts/build-download-page.mjs && tsc && vite build && node scripts/build-home-pages.mjs && node scripts/build-sitemap.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:corpus": "node scripts/build-pattern-corpus.mjs",
    "build:model": "node scripts/build-mapping-model.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "build:desktop": "npm run build && node scripts/prune-desktop-dist.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/quicksand": "^5.2.10",
    "@supabase/supabase-js": "^2.108.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1108.0",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
