# Config for the Supabase -> VPS data migration scripts. Copy to `.env` in this
# folder and fill in. NEVER commit the filled-in .env (it holds service-role keys
# and DB passwords). `scripts/migrate/.env` is gitignored.
#
# Load it with:   node --env-file=scripts/migrate/.env scripts/migrate/copy-storage.mjs
#          and:   the dump-db.sh script auto-sources this file if present.

# ---- SOURCE: your current hosted Supabase project -------------------------
# DB connection string: Supabase dashboard -> Project Settings -> Database ->
# Connection string -> URI (use the direct 5432 string, not the pooler).
SOURCE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SOURCE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Project Settings -> API -> service_role secret (server-only; bypasses RLS).
SOURCE_SERVICE_ROLE_KEY=eyJ-hosted-service-role-key

# ---- DEST: self-hosted Supabase on the VPS --------------------------------
# Must be the postgres SUPERUSER (the restore disables triggers). When running
# on the VPS itself this is usually localhost against the compose Postgres.
DEST_DB_URL=postgresql://postgres:PASSWORD@localhost:5432/postgres
DEST_SUPABASE_URL=https://api.sheepex.net
DEST_SERVICE_ROLE_KEY=eyJ-vps-service-role-key

# Storage bucket to copy (matches MAPS_BUCKET in src/lib/supabase.ts).
BUCKET=maps
